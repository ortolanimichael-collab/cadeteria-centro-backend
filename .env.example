# Copiá este archivo a ".env" y completá los valores reales.
# NUNCA subas el archivo ".env" real a GitHub — solo este ejemplo.

# Base de datos (Render te la da al crear el Postgres, empieza con postgres://)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Clave secreta para firmar los tokens de sesión (JWT). Generá una larga y random.
JWT_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Clave temporal para crear el primer admin por HTTP (sin consola). Usala una vez
# con /api/setup/create-admin y después no importa si se pierde — el endpoint se
# autobloquea en cuanto existe un admin.
SETUP_SECRET=cambiar-por-una-clave-larga-y-aleatoria

# Dominio(s) del frontend que tienen permiso de llamar a esta API (separados por coma)
CORS_ORIGINS=https://cadeteria-centro.onrender.com,http://localhost:5500

# --- Envío de emails (recuperar contraseña) ---
# Usamos Resend (resend.com) en vez de SMTP directo, porque Render bloquea
# las conexiones SMTP salientes en el plan gratuito. Resend tiene un plan
# gratis de sobra para esto (3.000 emails/mes). Creá una cuenta ahí, generá
# una API key, y pegala acá:
RESEND_API_KEY=re_tu_api_key_aca

# Remitente que va a figurar en los emails. Mientras no verifiques tu propio
# dominio en Resend, tenés que dejar este exacto (es el dominio de prueba
# que Resend te presta gratis):
RESEND_FROM=Cadetería Centro <onboarding@resend.dev>

# URL del frontend, para armar el link que va adentro del email de reset
FRONTEND_URL=https://cadeteria-centro.onrender.com

# --- Integración con el Panel de Membresías ---

# URL base de tu panel de membresías (para avisarle cuando se registra un negocio nuevo)
PANEL_MEMBRESIAS_URL=https://panel-membresias.onrender.com

# Clave compartida para autenticar las llamadas SALIENTES hacia el panel de membresías
PANEL_MEMBRESIAS_API_KEY=cambiar-por-una-clave-compartida-con-el-panel

# Clave compartida para autenticar las llamadas ENTRANTES desde el panel de membresías
# (el panel tiene que mandar esta misma clave en el header X-Webhook-Secret)
MEMBERSHIP_WEBHOOK_SECRET=cambiar-por-otra-clave-compartida
